# En desarrollo se recomienda dejarlo vacío: Vite envía /api/v1 al backend local.
# Definilo únicamente si el frontend debe consumir una API alojada en otro origen.
VITE_API_URL=

# El MVP está enfocado en organizadores. Activá estas funciones gradualmente.
VITE_FEATURE_PLAYER_ACCOUNTS=false
VITE_FEATURE_TEAM_DIRECTOR_ACCOUNTS=false
VITE_FEATURE_CLAIMS=false
VITE_FEATURE_NOTIFICATIONS=false
VITE_FEATURE_FAVORITES=false
